# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.*
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.vercel

# personal scripts
push-personal.sh
visual-audit/
/linkedin

# claude code local state (settings, worktrees, transcripts) — never commit
.claude/
# Local agent config
.github/agents/

# Playwright visual regression snapshots (generated locally, not committed)
e2e/__snapshots__/

# ── Internal documentation — architecture, strategy, and proprietary designs ─
# These contain competitive intelligence (system design, roadmaps, security
# architecture, AI platform plans). Keep local only.
docs/

# ── Security: sensitive files that must NEVER be committed ──────────────────
# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# SSH keys
id_rsa
id_ed25519
*.pub

# API key files
*-credentials.json
*-service-account.json
service-account*.json
gcloud-*.json

# IDE / editor secrets
.idea/
.vscode/settings.json
.vscode/launch.json

# OS metadata
Thumbs.db
.DS_Store
desktop.ini

# Database files
*.sqlite
*.sqlite3
*.db

# Log files that may contain sensitive data
*.log
logs/

# Backup files
*.bak
*.backup
*.swp
*.swo
*~
