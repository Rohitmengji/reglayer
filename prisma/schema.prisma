// RegLayer — Database Schema
// Multi-tenant accessibility compliance platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Identity & Multi-Tenancy
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  plan          Plan      @default(FREE)
  aiCreditsUsed Int       @default(0)
  bonusCredits  Int       @default(0)
  creditResetAt DateTime  @default(now())
  isMasterAdmin        Boolean   @default(false)
  onboardingDismissed  Boolean   @default(false)
  persona              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // Set to "now" to revoke a user's existing sessions (deprovision / sign-out-everywhere).
  // The jwt callback rejects tokens issued before this timestamp.
  sessionsRevokedAt    DateTime?

  // Relations
  memberships    WorkspaceMember[]
  scans          Scan[]
  apiKeys        ApiKey[]
  accessRequests AccessRequest[]
  creditGrants   CreditGrant[]
  agencies       Agency[]
  violationComments ViolationComment[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Credit Grants (admin → user, max 3x/month/user)
// ─────────────────────────────────────────────

model CreditGrant {
  id        String   @id @default(cuid())
  amount    Int
  reason    String?
  grantedBy String   // admin user ID
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_grants")
}

// ─────────────────────────────────────────────
// Password Reset OTP
// ─────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, otp])
  @@map("password_resets")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  region    String   @default("us-east") // data residency: "us-east" | "eu-west" | "ap-south" | "ap-southeast"
  stripeCustomerId   String?   @unique
  stripeSubscriptionId String?
  stripePriceId      String?
  trialEndsAt        DateTime?
  billingEmail       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members      WorkspaceMember[]
  sites        Site[]
  scans        Scan[]
  schedules    Schedule[]
  webhooks     Webhook[]
  monitors     Monitor[]
  apiKeys      ApiKey[]
  agencyClient AgencyClient?
  featureOverrides WorkspaceFeature[]
  proofs       ComplianceProof[]
  guardPolicies GuardPolicy[]
  auditRequests AuditRequest[]
  complianceRules ComplianceRule[]
  ssoConnections SSOConnection[]
  serviceAccounts ServiceAccount[]
  competitors  Competitor[]

  @@map("workspaces")
}

// ─────────────────────────────────────────────
// Feature Gating (per-workspace overrides)
// ─────────────────────────────────────────────

model WorkspaceFeature {
  id          String   @id @default(cuid())
  feature     String   // e.g. "executive", "agency", "compliance", "automation"
  enabled     Boolean  @default(true)
  grantedBy   String   // master admin user ID who enabled/disabled
  grantedAt   DateTime @default(now())
  expiresAt   DateTime? // optional: time-limited trial access
  note        String?  // admin note, e.g. "Annual deal includes Executive"

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, feature])
  @@map("workspace_features")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────────────
// Sites & Monitoring
// ─────────────────────────────────────────────

model Site {
  id          String   @id @default(cuid())
  url         String
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Relations
  scans       Scan[]
  schedules   Schedule[]
  riskScores  LitigationRiskScore[]
  proofs      ComplianceProof[]
  guardPolicies GuardPolicy[]
  auditRequests AuditRequest[]

  @@unique([workspaceId, url])
  @@map("sites")
}

// ─────────────────────────────────────────────
// Scans & Results
// ─────────────────────────────────────────────

model Scan {
  id            String     @id @default(cuid())
  url           String
  status        ScanStatus @default(PENDING)
  score         Float?
  totalViolations Int      @default(0)
  critical      Int        @default(0)
  serious       Int        @default(0)
  moderate      Int        @default(0)
  minor         Int        @default(0)
  compliance    Float?
  pageTitle     String?
  duration      Int?       // milliseconds
  screenshot    String?    // base64 or URL
  metadata      Json?      // additional scan metadata
  errorMessage  String?
  region        String?    // scan region (us-east, eu-west, etc.)

  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())

  // Relations
  workspaceId   String?
  siteId        String?
  userId        String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  site          Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  violations    Violation[]
  riskScore     LitigationRiskScore?

  @@index([workspaceId, createdAt])
  @@index([userId])
  @@index([url])
  @@index([status])
  @@map("scans")
}

model Violation {
  id              String   @id @default(cuid())
  ruleId          String   // axe rule ID (e.g., "color-contrast")
  impact          Impact
  description     String
  help            String
  helpUrl         String?
  tags            String[] // WCAG tags
  wcagCriteria    String?  // e.g., "1.4.3"
  wcagLevel       String?  // A, AA, AAA
  affectedElements Json    // array of { html, target, failureSummary }
  aiExplanation   String?  // cached AI explanation

  // ── Embedding (pgvector) ──
  // Stores the semantic vector for similarity search.
  // Managed via raw SQL — Prisma doesn't support vector natively.
  embedding       Unsupported("vector(1536)")?

  // ── Status Tracking (Fix Flow integration) ──
  status          ViolationStatus @default(OPEN)
  statusNote      String?         // required reason for WONT_FIX or ACCEPTABLE_RISK
  statusUpdatedAt DateTime?       // last status change timestamp
  statusUpdatedBy String?         // userId who changed status
  verifiedAt      DateTime?       // set when re-scan confirms fix is applied

  scanId          String
  scan            Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  comments        ViolationComment[]

  @@index([scanId])
  @@index([ruleId])
  @@index([status])
  @@map("violations")
}

enum ViolationStatus {
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED        // confirmed fixed by re-scan
  WONT_FIX        // intentional decision — requires statusNote
  ACCEPTABLE_RISK // documented exception — requires statusNote
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum Impact {
  critical
  serious
  moderate
  minor
}

// ─────────────────────────────────────────────
// Scheduling & Automation
// ─────────────────────────────────────────────

model Schedule {
  id          String   @id @default(cuid())
  name        String
  cron        String   // cron expression
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  siteId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([siteId])
  @@index([enabled, nextRunAt])
  @@map("schedules")
}

// ─────────────────────────────────────────────
// Integrations
// ─────────────────────────────────────────────

model Webhook {
  id          String      @id @default(cuid())
  name        String?
  url         String
  events      String[]    // ["scan.completed", "score.dropped"]
  secret      String?     // HMAC signing secret
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())

  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model Monitor {
  id          String    @id @default(cuid())
  name        String
  url         String
  condition   String    // score_below | score_drop | new_critical | new_violations
  threshold   Int
  notifyVia   String    @default("webhook")
  webhookUrl  String?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  siteId      String?
  @@index([workspaceId, url])
  @@map("monitors")
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique // hashed API key
  prefix      String   // first 8 chars for identification
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────
// Audit Trail
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // "scan.created", "member.invited", etc.
  actor       String?  // user ID
  target      String?  // resource ID
  metadata    Json?
  createdAt   DateTime @default(now())

  workspaceId String?

  @@index([workspaceId, createdAt])
  @@index([actor, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Product Analytics / Conversion Tracking
// ─────────────────────────────────────────────

model ConversionEvent {
  id         String   @id @default(cuid())
  event      String   // "demo_scan", "signup_started", "signup_completed", "first_scan", "plan_upgraded"
  sessionId  String   // anonymous session ID (cookie-based)
  userId     String?  // set after signup
  email      String?  // set after signup
  ip         String?
  referrer   String?
  userAgent  String?
  metadata   Json?    // { url, score, source, etc. }
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([event, createdAt])
  @@index([userId])
  @@map("conversion_events")
}

// ─────────────────────────────────────────────
// Access Requests (for Google/OAuth onboarding)
// ─────────────────────────────────────────────

model AccessRequest {
  id          String        @id @default(cuid())
  status      RequestStatus @default(PENDING)
  message     String?       // Optional message from the user
  workspaceId String?       // If they request a specific workspace
  resolvedBy  String?       // User ID of who approved/denied
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("access_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

// ─────────────────────────────────────────────
// Notification Preferences
// ─────────────────────────────────────────────

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  scanComplete     Boolean @default(true)
  weeklyDigest     Boolean @default(true)
  newViolations    Boolean @default(true)
  complianceAlerts Boolean @default(true)
  teamActivity     Boolean @default(false)
  scheduledReports Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

// ─────────────────────────────────────────────
// External Integrations
// ─────────────────────────────────────────────

model Integration {
  id            String   @id @default(cuid())
  provider      String   // "slack", "jira", "github", etc.
  name          String?  // user-given label
  enabled       Boolean  @default(true)
  accessToken   String?  // encrypted OAuth token
  refreshToken  String?  // encrypted refresh token
  webhookUrl    String?  // incoming webhook URL (Slack, Teams)
  externalId    String?  // external workspace/project ID
  config        Json?    // provider-specific config (channel, project key, etc.)
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspaceId   String
  userId        String   // who connected it

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("integrations")
}

// ─────────────────────────────────────────────
// Saved Auth Configs (encrypted credentials for authenticated scanning)
// ─────────────────────────────────────────────

model AuthConfig {
  id            String   @id @default(cuid())
  name          String   // User-facing label
  domain        String?  // Target domain (informational)
  method        String   // cookies | form | basic | headers
  encryptedData String   @db.Text // AES-256-GCM encrypted JSON (never exposed to client)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  workspaceId   String

  @@unique([workspaceId, name])
  @@index([userId])
  @@index([workspaceId])
  @@map("auth_configs")
}

// ─────────────────────────────────────────────
// White-Label Agency Platform
// ─────────────────────────────────────────────

model Agency {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  customDomain      String?     @unique
  logoUrl           String?
  primaryColor      String      @default("#6366f1")
  accentColor       String      @default("#4f46e5")
  faviconUrl        String?
  brandName         String
  supportEmail      String?
  plan              AgencyPlan  @default(STARTER)
  revenueSharePct   Int         @default(0)
  maxClients        Int         @default(10)
  isActive          Boolean     @default(true)
  ownerId           String
  owner             User        @relation(fields: [ownerId], references: [id])
  clients           AgencyClient[]
  apiKeys           AgencyApiKey[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([ownerId])
  @@map("agencies")
}

enum AgencyPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model AgencyClient {
  id            String    @id @default(cuid())
  agencyId      String
  workspaceId   String    @unique
  agency        Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  clientName    String
  contactEmail  String
  isActive      Boolean   @default(true)
  addedAt       DateTime  @default(now())

  @@index([agencyId])
  @@map("agency_clients")
}

model AgencyApiKey {
  id          String    @id @default(cuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  keyHash     String    @unique
  keyPrefix   String
  label       String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([agencyId])
  @@map("agency_api_keys")
}

// ─────────────────────────────────────────────
// Lawsuit Risk Score Engine
// ─────────────────────────────────────────────

model LitigationRiskScore {
  id                  String   @id @default(cuid())
  siteId              String
  scanId              String   @unique
  site                Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  scan                Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  baseScore           Float
  finalScore          Float
  tier                RiskTier
  industry            String
  primaryGeo          String
  industryMultiplier  Float
  geoMultiplier       Float
  estimatedExposure   Float
  violationBreakdown  Json
  topRiskFactors      Json
  narrative           String?
  calculatedAt        DateTime @default(now())

  @@index([siteId, calculatedAt])
  @@map("litigation_risk_scores")
}

enum RiskTier {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model LitigationWeight {
  id              String   @id @default(cuid())
  ruleId          String   @unique
  weight          Float
  frequency       Float
  avgSettlement   Float
  updatedAt       DateTime @updatedAt

  @@map("litigation_weights")
}

// One row per real legal event, paired with the risk prediction that preceded it.
// Standalone (no enforced relations) so an outcome survives deletion of its source
// scan/site — mirroring FixOutcomeRecord/VendorObservation. This is the ground-truth
// half of the litigation dataset: over time it calibrates the predicted-risk engine.
model LitigationOutcome {
  id                String                @id @default(cuid())
  workspaceId       String?
  siteId            String?
  scanId            String? // scan whose risk score this outcome is paired with, if known
  outcomeType       LitigationOutcomeType
  amountUsd         Float? // settlement or demand amount, if any
  occurredAt        DateTime // when the legal event actually happened
  source            String                @default("manual") // manual | imported | integration
  notes             String?
  // Prediction snapshot at logging time — lets us calibrate without re-deriving a
  // historical score (which drifts as LitigationWeight values are retrained).
  predictedTier     String?
  predictedExposure Float?
  createdAt         DateTime              @default(now())

  @@index([workspaceId, occurredAt])
  @@index([siteId, occurredAt])
  @@index([outcomeType, occurredAt])
  @@map("litigation_outcomes")
}

enum LitigationOutcomeType {
  DEMAND_LETTER
  LAWSUIT_FILED
  SETTLED
  DISMISSED
  NO_ACTION
}

// ─────────────────────────────────────────────
// Compliance Proof Vault
// ─────────────────────────────────────────────

model ComplianceProof {
  id            String        @id @default(cuid())
  siteId        String
  scanId        String?
  workspaceId   String
  type          ProofType
  title         String
  description   String?
  score         Float?
  standard      String        // e.g. "WCAG 2.1 AA", "EN 301 549", "Section 508"
  evidence      Json          // snapshot of scan data, violation counts, etc.
  hash          String        // SHA-256 over canonical(evidence + prevHash + chainIndex + issuedAt)
  prevHash      String?       // hash of the previous proof in this workspace's chain (null = genesis)
  chainIndex    Int           @default(0) // 0-based position in the workspace's hash chain
  anchoredAt    DateTime?     // when the hash was externally anchored (e.g. OpenTimestamps)
  anchorProof   String?       // opaque external anchor receipt, if any
  issuedAt      DateTime      @default(now())
  expiresAt     DateTime?     // optional: proof validity period
  revokedAt     DateTime?     // set if score drops below threshold
  revokedReason String?

  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, chainIndex])
  @@index([workspaceId, issuedAt])
  @@index([siteId, issuedAt])
  @@index([hash])
  @@map("compliance_proofs")
}

enum ProofType {
  SCAN_CERTIFICATE
  COMPLIANCE_SNAPSHOT
  REMEDIATION_RECORD
  AUDIT_ATTESTATION
  CONTINUOUS_MONITORING
}

// ─────────────────────────────────────────────
// CI/CD Regression Guard
// ─────────────────────────────────────────────

model GuardPolicy {
  id                  String    @id @default(cuid())
  siteId              String
  workspaceId         String
  name                String
  enabled             Boolean   @default(true)

  // Regression-Only Mode: when true, the gate ONLY fails on NET-NEW violations
  // introduced since the baseline — pre-existing issues are ignored.
  // This is what makes the gate usable for teams inheriting legacy violations.
  regressionOnly      Boolean   @default(false)

  // Absolute thresholds (skipped when regressionOnly=true)
  minScore            Float     @default(80)
  maxCritical         Int       @default(0)
  maxSerious          Int       @default(3)

  // Regression tolerances
  maxScoreDrop        Float     @default(5)
  maxNewViolations    Int       @default(5)

  // Baseline
  autoPromoteBaseline Boolean   @default(true)
  baselineScanId      String?
  baselineScore       Float?
  baselineLockedAt    DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  site                Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([siteId, name])
  @@index([workspaceId])
  @@map("guard_policies")
}

/// Organization-defined compliance policy evaluated over scan results.
/// THRESHOLD: { minScore }              — overall score floor
/// RULE_REQUIRED: { axeRuleId }         — a specific axe rule must have zero violations
/// IMPACT_BUDGET: { impact, maxCount }  — at most N violations of a given impact
/// CRITERION_REQUIRED: { criterion }    — a WCAG criterion (e.g. "1.4.3") must have zero violations
enum ComplianceRuleType {
  THRESHOLD
  RULE_REQUIRED
  IMPACT_BUDGET
  CRITERION_REQUIRED
}

model ComplianceRule {
  id          String             @id @default(cuid())
  workspaceId String
  name        String
  description String?
  enabled     Boolean            @default(true)
  type        ComplianceRuleType
  config      Json
  severity    Impact             @default(serious)
  createdBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("compliance_rules")
}

/// Enterprise SSO — multi-tenant. Our routing/provisioning metadata; the actual
/// IdP config lives in BoxyHQ Jackson's own tables keyed by (tenant=workspaceId, product).
/// SSO is ADDITIVE in v1 (never enforced) so a broken IdP can't lock anyone out.
enum SsoProtocol {
  SAML
  OIDC
}

enum SsoRolloutStage {
  DISABLED
  INTERNAL
  BETA
  GA
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DomainVerificationMethod {
  DNS_TXT
  EMAIL
}

enum SsoHealthStatus {
  ACTIVE
  WARNING
  EXPIRED_CERT
  INVALID_METADATA
  VALIDATION_FAILED
  DISABLED
}

enum SsoEnforcementPolicy {
  OPTIONAL
  ENFORCED
  ENFORCED_VERIFIED_DOMAINS
}

enum SsoAttributeTarget {
  firstName
  lastName
  fullName
  department
  title
  location
  employeeId
}

enum SsoConnectionChangeType {
  CREATED
  UPDATED
  DELETED
  ENABLED
  DISABLED
  DOMAIN_VERIFIED
  ROLE_MAPPING_CHANGED
}

model SSOConnection {
  id                String               @id @default(cuid())
  workspaceId       String
  product           String               @default("reglayer")
  label             String
  protocol          SsoProtocol
  defaultRole       Role                 @default(MEMBER)
  rolloutStage      SsoRolloutStage      @default(DISABLED)
  // v1 is always OPTIONAL (additive); ENFORCED ships only at GA with a break-glass path
  enforcementPolicy SsoEnforcementPolicy @default(OPTIONAL)
  // Reliability / health (#21, #22)
  healthStatus         SsoHealthStatus   @default(ACTIVE)
  certificateExpiresAt DateTime?
  warningThresholdDays Int               @default(30)
  lastValidatedAt      DateTime?
  // Public IdP endpoints kept for self-healing health probes (#43). NOT secrets —
  // OIDC client secret lives only in Jackson, never here.
  metadataUrl      String?
  oidcDiscoveryUrl String?
  // SCIM forward-compat (unused in v1; reserved so SCIM adds no migration pain)
  scimEnabled    Boolean                 @default(false)
  scimEndpoint   String?
  scimSecretHash String?
  lastLoginAt    DateTime?
  lastSSOLoginAt DateTime?
  createdBy      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  disabledAt     DateTime? // soft-disable
  deletedAt      DateTime? // soft-delete — releases owned domains

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domains           SsoDomain[]
  roleMappings      SsoRoleMapping[]
  attributeMappings SsoAttributeMapping[]
  auditEvents       SsoConnectionAudit[]
  verifiedDomains   VerifiedDomain[]

  @@index([workspaceId])
  @@map("sso_connections")
}

model SsoDomain {
  id                 String                    @id @default(cuid())
  connectionId       String
  workspaceId        String // denormalized for routing + uniqueness
  domain             String // always stored lowercased
  isPrimary          Boolean                   @default(false)
  verificationStatus DomainVerificationStatus  @default(PENDING)
  verificationMethod DomainVerificationMethod?
  verificationToken  String
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime                  @default(now())
  deletedAt          DateTime?

  connection         SSOConnection             @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // Global uniqueness of VERIFIED, non-deleted domains is enforced at the app layer
  // (transaction-guarded check) AND a Postgres partial unique index added via raw SQL
  // (CREATE UNIQUE INDEX ... WHERE verification_status='VERIFIED' AND deleted_at IS NULL),
  // since Prisma can't express partial-unique declaratively.
  @@index([connectionId])
  @@index([domain, verificationStatus, deletedAt])
  @@map("sso_domains")
}

/// Race-safe, migration-safe global uniqueness for verified SSO domains (review #2).
/// One row per currently-verified domain with a NATIVE @@unique — replaces the
/// fragile raw partial-index. Insert on verify (catch P2002 → already claimed),
/// delete on soft-delete/transfer. Routing/provisioning treat presence here as
/// the source of truth for "this domain belongs to exactly one workspace".
model VerifiedDomain {
  id           String        @id @default(cuid())
  domain       String        @unique // lowercased; exactly one workspace per verified domain
  workspaceId  String
  connectionId String
  verifiedAt   DateTime      @default(now())

  connection   SSOConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("sso_verified_domains")
}

/// IdP group → workspace role (#25). Schema now, wired in the provisioning phase.
model SsoRoleMapping {
  id           String        @id @default(cuid())
  connectionId String
  idpGroup     String
  role         Role
  createdAt    DateTime      @default(now())

  connection   SSOConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, idpGroup])
  @@index([connectionId])
  @@map("sso_role_mappings")
}

/// IdP attribute → user profile field (#26). Schema now, wired in the provisioning phase.
model SsoAttributeMapping {
  id           String             @id @default(cuid())
  connectionId String
  sourceAttr   String
  targetField  SsoAttributeTarget
  createdAt    DateTime           @default(now())

  connection   SSOConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, targetField])
  @@index([connectionId])
  @@map("sso_attribute_mappings")
}

/// Tamper-evident change history for SSO config (#32): who/when/before/after/why.
model SsoConnectionAudit {
  id           String                  @id @default(cuid())
  connectionId String
  actor        String?
  changeType   SsoConnectionChangeType
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime                @default(now())

  connection   SSOConnection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@map("sso_connection_audit")
}

/// Service accounts exempt from SSO enforcement (#24), so automation never gets locked out.
model ServiceAccount {
  id                       String    @id @default(cuid())
  workspaceId              String
  email                    String
  label                    String
  exemptFromSsoEnforcement Boolean   @default(true)
  createdBy                String?
  createdAt                DateTime  @default(now())

  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("service_accounts")
}

// ─────────────────────────────────────────────
// Human Testing Network
// ─────────────────────────────────────────────

model Tester {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  bio             String?
  expertise       String[]
  certifications  String[]
  assistiveTech   String[]
  disabilities    String[]
  hourlyRate      Float     @default(0)
  currency        String    @default("USD")
  availability    String    @default("available") // available | limited | unavailable
  completedAudits Int       @default(0)
  averageRating   Float     @default(0)
  region          String    @default("US")
  languages       String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  auditRequests   AuditRequest[]

  @@map("testers")
}

model AuditRequest {
  id              String    @id @default(cuid())
  workspaceId     String
  siteId          String
  testerId        String?
  type            String    // full-audit | screen-reader-test | keyboard-test | etc.
  status          String    @default("draft") // draft | submitted | matched | in-progress | review | completed | cancelled
  scope           String
  requirements    String?
  urgency         String    @default("standard") // standard | rush | critical
  budget          Float?
  currency        String    @default("USD")
  findings        Json?
  combinedScore   Float?
  automatedScore  Float?
  manualScore     Float?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tester          Tester?   @relation(fields: [testerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([testerId])
  @@map("audit_requests")
}

// ─────────────────────────────────────────────
// Blog CMS — Admin-editable articles
// ─────────────────────────────────────────────

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  category    String        // "WCAG", "EAA", "Legal", "Technical", etc.
  content     Json          // Structured sections array
  status      ArticleStatus @default(DRAFT)
  readTime    String        @default("5 min")
  authorId    String?       // User who created
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Version history — append-only, never deletes old content
  versions    ArticleVersion[]

  @@index([status, publishedAt])
  @@map("articles")
}

model ArticleVersion {
  id          String   @id @default(cuid())
  articleId   String
  content     Json     // Full snapshot of content at this point
  title       String
  excerpt     String
  editedBy    String   // User ID who made the edit
  editMethod  String   @default("manual") // "manual" | "ai"
  changeNote  String?  // What was changed
  createdAt   DateTime @default(now())

  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@map("article_versions")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─────────────────────────────────────────────
// Crawl Durability (R-5) — survives Vercel cold starts
// ─────────────────────────────────────────────

model CrawlJobRecord {
  id           String   @id
  workspaceId  String?
  userId       String?
  rootUrl      String
  status       String   @default("processing") // processing|complete|failed|cancelled
  progress     Int      @default(0)
  pagesScanned Int      @default(0)
  pagesTotal   Int      @default(0)
  result       Json?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, createdAt])
  @@map("crawl_jobs")
}

// ─────────────────────────────────────────────
// RUM Persistence (R-6) — durable real-user events
// ─────────────────────────────────────────────

model RumEventRecord {
  id          String   @id @default(cuid())
  workspaceId String?
  siteKey     String
  type        String
  selector    String
  page        String
  sessionId   String
  viewport    Json?
  details     Json?
  userAgent   String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([workspaceId, occurredAt])
  @@index([siteKey, occurredAt])
  @@map("rum_events")
}

// ── Fix Genome ──
// Crowd-verified remediation outcomes. One row per confirmed (or refuted) fix attempt,
// keyed by the violation's ruleId + a normalized structural fingerprint. Aggregating
// across tenants yields "for this barrier, fix X works Y% of the time, median Z days" —
// a network-effect dataset no single-site tool can assemble. Standalone (no enforced
// relations) so an outcome survives deletion of its source scan/violation, mirroring
// the RumEventRecord pattern.
model FixOutcomeRecord {
  id           String   @id @default(cuid())
  workspaceId  String?
  siteId       String?
  violationId  String?
  ruleId       String // axe rule id — the primary fingerprint key
  fingerprint  String // ruleId + normalized selector, for finer-grained grouping
  fixCategory  String? // optional fix taxonomy label
  impact       String? // violation impact at fix time
  verifiedVia  String // "re-scan" | "rum-drop" | "manual"
  success      Boolean // did the rule stop appearing after the fix?
  detectedAt   DateTime? // when the violation was first detected
  verifiedAt   DateTime // when this outcome was confirmed
  daysToEffect Float? // verifiedAt − detectedAt, in days, when both are known
  createdAt    DateTime @default(now())

  @@index([ruleId, success])
  @@index([workspaceId, ruleId, createdAt])
  @@index([fingerprint, success])
  @@map("fix_outcomes")
}

// ── Vendor Accessibility Liability Graph (VALG) ──
// One row per (scan, vendor) observation. Aggregating across tenants scores every
// third-party widget by the real-world accessibility liability it injects across all
// sites that embed it — "the Moody's of web components" — and tracks regression over
// time. Standalone (no enforced relations) so an observation survives deletion of its
// source scan, mirroring the RumEventRecord / FixOutcomeRecord pattern.
model VendorObservation {
  id             String   @id @default(cuid())
  workspaceId    String?
  siteId         String?
  scanId         String?
  vendor         String // vendor display name (e.g. "Intercom")
  category       String // VendorCategory (e.g. "chat-widget")
  violationCount Int // violations attributed to this vendor in the scan
  riskScore      Int // 0–100 vendor risk score from the scanner
  observedAt     DateTime
  createdAt      DateTime @default(now())

  @@index([vendor, observedAt])
  @@index([workspaceId, observedAt])
  @@map("vendor_observations")
}

// ─────────────────────────────────────────────
// Compliance Autopilot
// ─────────────────────────────────────────────
// Ties together scheduled scanning, evidence chain proofs, compliance reports,
// and certificate management into a single subscription-worthy feature.
// One Autopilot per (workspace, site) — the recurring compliance engine.

model ComplianceAutopilot {
  id              String    @id @default(cuid())
  workspaceId     String
  siteId          String
  enabled         Boolean   @default(true)

  // Auto-issue evidence chain proof after each successful scan
  autoProof       Boolean   @default(true)
  // Auto-revoke certificate if score drops below threshold
  autoRevoke      Boolean   @default(true)
  revokeThreshold Int       @default(70) // Score below which cert is revoked

  // Scheduled report delivery
  reportEnabled   Boolean   @default(true)
  reportFrequency String    @default("monthly") // weekly | monthly | quarterly
  reportRecipients String[] // Email addresses to receive reports
  lastReportSentAt DateTime?
  nextReportAt    DateTime?

  // Streak tracking
  consecutivePasses Int     @default(0) // Scans in a row ≥ revokeThreshold
  longestStreak     Int     @default(0)
  lastScanScore     Int?
  lastScanAt        DateTime?

  // Certificate management
  certificateId   String?   // Active ComplianceProof id serving as cert
  certificateRevokedAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, siteId])
  @@index([enabled, nextReportAt])
  @@map("compliance_autopilots")
}

// ─────────────────────────────────────────────
// Accessibility Compliance Warranty (ACW)
// ─────────────────────────────────────────────
// A legally-backed compliance warranty: RegLayer stands behind its monitoring with
// financial coverage. If a warranted site receives a demand letter while actively
// monitored with a score above the floor, RegLayer provides defense-file assembly,
// demand-letter triage, and legal cost coverage up to the tier limit.
//
// Standalone (no cascading deletes from Site/Workspace) so warranty history and
// claims survive site deletion — legal records must be immutable.

enum WarrantyTier {
  SHIELD       // $25k coverage, basic
  FORTRESS     // $50k coverage, demand-letter response included
  VAULT        // $100k coverage, full legal coordination
}

enum WarrantyStatus {
  ACTIVE       // All eligibility conditions met, coverage in force
  SUSPENDED    // Score dropped below floor or monitoring gap detected
  CANCELLED    // Manually cancelled by customer or admin
  EXPIRED      // Contract period ended without renewal
  PENDING      // Enrolled but waiting for initial qualifying period (30 days)
}

enum ClaimStatus {
  SUBMITTED    // Customer submitted a claim
  UNDER_REVIEW // RegLayer reviewing eligibility
  APPROVED     // Claim accepted, coverage activated
  DENIED       // Claim denied (eligibility not met at time of incident)
  RESOLVED     // Claim fully processed and closed
}

model WarrantyPolicy {
  id              String          @id @default(cuid())
  workspaceId     String
  siteId          String
  tier            WarrantyTier
  status          WarrantyStatus  @default(PENDING)

  // Coverage parameters
  coverageLimit   Int             // Maximum coverage in USD cents
  scoreFloor      Int             @default(75) // Minimum score to maintain warranty
  monitoringGap   Int             @default(48) // Max hours without a scan before suspension

  // Contract dates
  enrolledAt      DateTime        @default(now())
  activatedAt     DateTime?       // When PENDING → ACTIVE (after qualifying period)
  suspendedAt     DateTime?       // Last suspension timestamp
  expiresAt       DateTime?       // Contract end date (null = auto-renew)
  cancelledAt     DateTime?

  // Pricing (stored for audit trail — actual billing via Stripe)
  monthlyPremium  Int             // Monthly premium in USD cents
  annualDiscount  Int             @default(0) // Discount percentage for annual commitment

  // Eligibility snapshot (updated on every scan)
  lastEligibilityCheck DateTime?
  currentScore         Int?
  consecutiveDaysAboveFloor Int   @default(0)
  totalMonitoredDays   Int        @default(0)

  // Suspension history counter
  suspensionCount Int             @default(0)

  claims          WarrantyClaim[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([workspaceId, siteId])
  @@index([status])
  @@index([siteId])
  @@map("warranty_policies")
}

model WarrantyClaim {
  id              String       @id @default(cuid())
  policyId        String
  policy          WarrantyPolicy @relation(fields: [policyId], references: [id])
  status          ClaimStatus  @default(SUBMITTED)

  // Incident details
  incidentDate    DateTime     // When the demand letter / complaint was received
  claimType       String       // "demand_letter" | "lawsuit" | "regulatory_complaint"
  description     String       @db.Text
  demandLetterUrl String?      // Uploaded document reference

  // Coverage decision
  coveredAmount   Int?         // Approved coverage amount in USD cents
  denialReason    String?
  reviewedAt      DateTime?
  reviewedBy      String?      // Admin user ID

  // Generated defense artifacts (references to existing systems)
  defenseFileId   String?      // Reference to generated defense file
  triageReportId  String?      // Reference to demand-letter triage output

  // Resolution
  resolvedAt      DateTime?
  resolutionNotes String?      @db.Text
  actualPayout    Int?         // Final payout in USD cents

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([policyId, status])
  @@map("warranty_claims")
}

// ─────────────────────────────────────────────
// Adversarial Accessibility Agents (Red Team)
// ─────────────────────────────────────────────
// Autonomous AI agents that ATTEMPT to use a site while simulating specific
// disabilities. Each agent has a GOAL (e.g. "complete checkout") and operates
// under CONSTRAINTS (e.g. keyboard-only, screen-reader-only). Reports where
// and why it fails — finding the 70% of barriers that rule-based scanning misses.

enum AgentPersona {
  KEYBOARD    // No mouse — Tab, Enter, Arrow, Escape only
  SCREEN_READER // Only accessibility tree (no visual content)
  MOTOR       // Slow input, large targets only, no drag, timeouts extended
  LOW_VISION  // 200% zoom, high contrast, text reflow
  COGNITIVE   // Tracks complexity, step count, decision load, timeouts
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED      // Agent infrastructure error (not a site barrier)
  TIMEOUT     // Exceeded time budget
}

enum StepOutcome {
  PASSED
  FAILED      // Barrier encountered — the agent got stuck
  SKIPPED     // Agent chose an alternate path
  TIMEOUT     // Step-level timeout
}

model AgentRun {
  id            String         @id @default(cuid())
  workspaceId   String
  siteId        String
  persona       AgentPersona
  goal          String         // Natural language: "Complete a purchase"
  startUrl      String         // Where the agent begins
  status        AgentRunStatus @default(QUEUED)

  // Results
  goalAchieved  Boolean        @default(false)
  totalSteps    Int            @default(0)
  failedAtStep  Int?           // Step index where the agent got stuck
  failureReason String?        @db.Text // Diagnostic: why the agent couldn't proceed
  duration      Int?           // Total run time in ms
  barriers      Json?          // Array of detected barriers with element/reason

  // Scheduling
  scheduledBy   String?        // "manual" | "cron" | schedule ID
  startedAt     DateTime?
  completedAt   DateTime?

  steps         AgentStep[]

  createdAt     DateTime       @default(now())

  @@index([workspaceId, persona, createdAt])
  @@index([siteId, status])
  @@map("agent_runs")
}

model AgentStep {
  id          String       @id @default(cuid())
  runId       String
  run         AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex   Int
  action      String       // "navigate" | "click" | "type" | "press" | "wait"
  target      String?      // Selector or description of what the agent interacted with
  reasoning   String?      // LLM's reasoning for choosing this action
  outcome     StepOutcome
  annotation  String?      // What went wrong (if FAILED)
  duration    Int?         // Step time in ms
  screenshot  String?      // Base64 or URL of screenshot at this step

  createdAt   DateTime     @default(now())

  @@index([runId, stepIndex])
  @@map("agent_steps")
}

// ─────────────────────────────────────────────
// Dependency Accessibility Intelligence
// ─────────────────────────────────────────────
// Tracks which npm packages / third-party libraries are present on scanned sites,
// correlates version changes with accessibility regressions across tenants, and
// generates advisories warning users BEFORE they update a risky dependency.
// "Snyk for Accessibility" — powered by cross-tenant outcome data.

model DependencyObservation {
  id          String   @id @default(cuid())
  workspaceId String?
  siteId      String?
  scanId      String?
  package     String   // e.g. "@radix-ui/react-dialog", "react", "next"
  version     String   // e.g. "1.1.0"
  source      String   // "script_tag" | "meta" | "package_json" | "dom_pattern"
  score       Int?     // Site score at the time of this observation
  observedAt  DateTime @default(now())

  @@index([package, version, observedAt])
  @@index([workspaceId, observedAt])
  @@index([siteId, package])
  @@map("dependency_observations")
}

enum AdvisoryLevel {
  INFO        // Informational — minor pattern change detected
  WARNING     // Moderate regression risk (10-25% of sites affected)
  CRITICAL    // High regression risk (>25% of sites affected)
}

model DependencyAdvisory {
  id              String        @id @default(cuid())
  package         String        // Package name
  fromVersion     String        // Version before regression
  toVersion       String        // Version that caused regression
  level           AdvisoryLevel
  title           String        // e.g. "Focus trap removed in dialog"
  description     String        @db.Text
  affectedCriteria String[]     // WCAG criteria affected: ["2.4.3", "2.1.2"]
  regressionRate  Float         // 0-1: fraction of sites that regressed
  sitesAffected   Int           // Count of sites that experienced regression
  sitesTotal      Int           // Total sites that updated
  avgScoreDrop    Float         // Average score decrease
  fixSuggestion   String?       @db.Text // Proven fix from Fix Genome
  fixSuccessRate  Float?        // 0-1: how often the suggested fix works
  publishedAt     DateTime      @default(now())
  resolvedAt      DateTime?     // When the package author fixed it (if ever)

  @@unique([package, fromVersion, toVersion])
  @@index([package, publishedAt])
  @@index([level, publishedAt])
  @@map("dependency_advisories")
}

// ─────────────────────────────────────────────
// Accessibility Proof of Impact (ROI Certificates)
// ─────────────────────────────────────────────
// Cryptographically-verified certificate proving the BUSINESS IMPACT of
// accessibility work: users unblocked, revenue enabled, risk reduced.
// Shareable publicly, verifiable without login, anchored in the Evidence Chain.

model ImpactCertificate {
  id              String   @id @default(cuid())
  workspaceId     String
  siteId          String
  periodStart     DateTime
  periodEnd       DateTime

  // Before-state snapshot
  scoreBefore     Int
  violationsBefore Int
  riskExposureBefore Int  // USD cents
  personasPassingBefore Int // Out of 5

  // After-state snapshot
  scoreAfter      Int
  violationsAfter Int
  riskExposureAfter Int   // USD cents
  personasPassingAfter Int

  // Computed impact metrics
  usersUnblocked      Int      // Estimated users who can now access
  revenueEnabled      Int      // USD cents — additional addressable revenue
  riskReduced         Int      // USD cents — litigation exposure delta
  violationsFixed     Int
  scoreImprovement    Int      // Points gained
  industryPercentile  Int?     // 0-100: where this site ranks in its industry

  // Evidence
  proofChainLength    Int      // Number of evidence chain proofs in period
  monitoringDays      Int      // Consecutive days monitored
  scansInPeriod       Int
  evidenceHash        String   // SHA-256 over the certificate data (verifiable)

  // Methodology inputs (stored for audit transparency)
  trafficEstimate     Int?     // Monthly unique visitors (user-provided or estimated)
  disabilityPrevalence Float   @default(0.15) // 15% global average
  avgConversionRate   Float?   // Site's conversion rate (user-provided)
  avgOrderValue       Int?     // USD cents (user-provided)
  industry            String?

  // Sharing
  isPublic            Boolean  @default(false)
  publicSlug          String?  @unique // Short URL for sharing

  createdAt           DateTime @default(now())

  @@index([workspaceId, periodEnd])
  @@index([siteId, periodEnd])
  @@index([publicSlug])
  @@map("impact_certificates")
}

// ─────────────────────────────────────────────
// Competitive Intelligence
// ─────────────────────────────────────────────

model Competitor {
  id          String   @id @default(cuid())
  url         String   // competitor's homepage URL
  name        String?  // display name (auto-detected or user-provided)
  industry    String?  // optional industry tag
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addedBy     String?  // userId who added this competitor
  createdAt   DateTime @default(now())

  snapshots   CompetitorSnapshot[]

  @@unique([workspaceId, url])
  @@index([workspaceId])
  @@map("competitors")
}

model CompetitorSnapshot {
  id             String   @id @default(cuid())
  competitorId   String
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  url            String   // the page scanned (may differ if competitor has multiple pages)
  score          Float    // accessibility score 0-100
  totalViolations Int     @default(0)
  critical       Int      @default(0)
  serious        Int      @default(0)
  moderate       Int      @default(0)
  minor          Int      @default(0)
  pageTitle      String?
  topIssues      Json?    // top 5 rule IDs with counts
  wcagLevel      String?  // highest passing level (A, AA, AAA)

  scannedAt      DateTime @default(now())

  @@index([competitorId, scannedAt])
  @@map("competitor_snapshots")
}

// ─── BoxyHQ Jackson SSO Tables ───────────────────────────────────────────────
// These tables are managed by the Jackson SSO service (docker-compose).
// They MUST be modeled here so `prisma db push` does not attempt to drop them.

model jackson_store {
  key           String          @id(map: "PK_87b6fc1475fbd1228d2f53c6f4a") @db.VarChar(1500)
  value         String
  iv            String?         @db.VarChar(64)
  tag           String?         @db.VarChar(64)
  createdAt     DateTime        @default(now()) @db.Timestamp(6)
  modifiedAt    DateTime?       @db.Timestamp(6)
  namespace     String?         @db.VarChar(256)
  jackson_index jackson_index[]

  @@index([namespace], map: "_jackson_store_namespace")
}

model jackson_index {
  id            Int           @id(map: "PK_a95aa83f01e3c73e126856b7820") @default(autoincrement())
  key           String        @db.VarChar(1500)
  storeKey      String        @db.VarChar(1500)
  jackson_store jackson_store @relation(fields: [storeKey], references: [key], onDelete: Cascade, onUpdate: NoAction, map: "FK_937b040fb2592b4671cbde09e83")

  @@index([key], map: "_jackson_index_key")
  @@index([key, storeKey], map: "_jackson_index_key_store")
}

model jackson_ttl {
  key       String @id(map: "PK_7c9bcdfb4d82e873e19935ec806") @db.VarChar(1500)
  expiresAt BigInt

  @@index([expiresAt], map: "_jackson_ttl_expires_at")
}

// ─────────────────────────────────────────────
// AI Observability — Usage & Cost Tracking
// ─────────────────────────────────────────────

model AiEvent {
  id            String   @id @default(cuid())
  type          String   // "ai.completion" | "ai.embedding"
  feature       String   // "chat" | "violation-explainer" | "visual-scan" etc.
  model         String   // "gpt-4o-mini" | "claude-haiku" etc.
  provider      String   // "openai" | "anthropic"
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  costUsd       Float    @default(0) // total cost in USD
  latencyMs     Int      @default(0)
  success       Boolean  @default(true)
  error         String?
  userId        String?
  workspaceId   String?
  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([feature, createdAt])
  @@index([userId, createdAt])
