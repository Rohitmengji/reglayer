// RegLayer — Database Schema
// Multi-tenant accessibility compliance platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Identity & Multi-Tenancy
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  plan          Plan      @default(FREE)
  aiCreditsUsed Int       @default(0)
  bonusCredits  Int       @default(0)
  creditResetAt DateTime  @default(now())
  isMasterAdmin        Boolean   @default(false)
  onboardingDismissed  Boolean   @default(false)
  persona              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  memberships    WorkspaceMember[]
  scans          Scan[]
  apiKeys        ApiKey[]
  accessRequests AccessRequest[]
  creditGrants   CreditGrant[]
  agencies       Agency[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Credit Grants (admin → user, max 3x/month/user)
// ─────────────────────────────────────────────

model CreditGrant {
  id        String   @id @default(cuid())
  amount    Int
  reason    String?
  grantedBy String   // admin user ID
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_grants")
}

// ─────────────────────────────────────────────
// Password Reset OTP
// ─────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, otp])
  @@map("password_resets")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  stripeCustomerId   String?   @unique
  stripeSubscriptionId String?
  stripePriceId      String?
  trialEndsAt        DateTime?
  billingEmail       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members      WorkspaceMember[]
  sites        Site[]
  scans        Scan[]
  schedules    Schedule[]
  webhooks     Webhook[]
  monitors     Monitor[]
  apiKeys      ApiKey[]
  agencyClient AgencyClient?
  featureOverrides WorkspaceFeature[]
  proofs       ComplianceProof[]
  guardPolicies GuardPolicy[]
  auditRequests AuditRequest[]
  complianceRules ComplianceRule[]
  ssoConnections SSOConnection[]
  serviceAccounts ServiceAccount[]

  @@map("workspaces")
}

// ─────────────────────────────────────────────
// Feature Gating (per-workspace overrides)
// ─────────────────────────────────────────────

model WorkspaceFeature {
  id          String   @id @default(cuid())
  feature     String   // e.g. "executive", "agency", "compliance", "automation"
  enabled     Boolean  @default(true)
  grantedBy   String   // master admin user ID who enabled/disabled
  grantedAt   DateTime @default(now())
  expiresAt   DateTime? // optional: time-limited trial access
  note        String?  // admin note, e.g. "Annual deal includes Executive"

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, feature])
  @@map("workspace_features")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────────────
// Sites & Monitoring
// ─────────────────────────────────────────────

model Site {
  id          String   @id @default(cuid())
  url         String
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Relations
  scans       Scan[]
  schedules   Schedule[]
  riskScores  LitigationRiskScore[]
  proofs      ComplianceProof[]
  guardPolicies GuardPolicy[]
  auditRequests AuditRequest[]

  @@unique([workspaceId, url])
  @@map("sites")
}

// ─────────────────────────────────────────────
// Scans & Results
// ─────────────────────────────────────────────

model Scan {
  id            String     @id @default(cuid())
  url           String
  status        ScanStatus @default(PENDING)
  score         Float?
  totalViolations Int      @default(0)
  critical      Int        @default(0)
  serious       Int        @default(0)
  moderate      Int        @default(0)
  minor         Int        @default(0)
  compliance    Float?
  pageTitle     String?
  duration      Int?       // milliseconds
  screenshot    String?    // base64 or URL
  metadata      Json?      // additional scan metadata
  errorMessage  String?

  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())

  // Relations
  workspaceId   String?
  siteId        String?
  userId        String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  site          Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  violations    Violation[]
  riskScore     LitigationRiskScore?

  @@index([workspaceId, createdAt])
  @@index([userId])
  @@index([url])
  @@index([status])
  @@map("scans")
}

model Violation {
  id              String   @id @default(cuid())
  ruleId          String   // axe rule ID (e.g., "color-contrast")
  impact          Impact
  description     String
  help            String
  helpUrl         String?
  tags            String[] // WCAG tags
  wcagCriteria    String?  // e.g., "1.4.3"
  wcagLevel       String?  // A, AA, AAA
  affectedElements Json    // array of { html, target, failureSummary }
  aiExplanation   String?  // cached AI explanation

  // ── Status Tracking (Fix Flow integration) ──
  status          ViolationStatus @default(OPEN)
  statusNote      String?         // required reason for WONT_FIX or ACCEPTABLE_RISK
  statusUpdatedAt DateTime?       // last status change timestamp
  statusUpdatedBy String?         // userId who changed status
  verifiedAt      DateTime?       // set when re-scan confirms fix is applied

  scanId          String
  scan            Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([ruleId])
  @@index([status])
  @@map("violations")
}

enum ViolationStatus {
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED        // confirmed fixed by re-scan
  WONT_FIX        // intentional decision — requires statusNote
  ACCEPTABLE_RISK // documented exception — requires statusNote
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum Impact {
  critical
  serious
  moderate
  minor
}

// ─────────────────────────────────────────────
// Scheduling & Automation
// ─────────────────────────────────────────────

model Schedule {
  id          String   @id @default(cuid())
  name        String
  cron        String   // cron expression
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  siteId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([siteId])
  @@index([enabled, nextRunAt])
  @@map("schedules")
}

// ─────────────────────────────────────────────
// Integrations
// ─────────────────────────────────────────────

model Webhook {
  id          String      @id @default(cuid())
  name        String?
  url         String
  events      String[]    // ["scan.completed", "score.dropped"]
  secret      String?     // HMAC signing secret
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())

  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model Monitor {
  id          String    @id @default(cuid())
  name        String
  url         String
  condition   String    // score_below | score_drop | new_critical | new_violations
  threshold   Int
  notifyVia   String    @default("webhook")
  webhookUrl  String?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  siteId      String?
  @@index([workspaceId, url])
  @@map("monitors")
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique // hashed API key
  prefix      String   // first 8 chars for identification
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────
// Audit Trail
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // "scan.created", "member.invited", etc.
  actor       String?  // user ID
  target      String?  // resource ID
  metadata    Json?
  createdAt   DateTime @default(now())

  workspaceId String?

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Product Analytics / Conversion Tracking
// ─────────────────────────────────────────────

model ConversionEvent {
  id         String   @id @default(cuid())
  event      String   // "demo_scan", "signup_started", "signup_completed", "first_scan", "plan_upgraded"
  sessionId  String   // anonymous session ID (cookie-based)
  userId     String?  // set after signup
  email      String?  // set after signup
  ip         String?
  referrer   String?
  userAgent  String?
  metadata   Json?    // { url, score, source, etc. }
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([event, createdAt])
  @@index([userId])
  @@map("conversion_events")
}

// ─────────────────────────────────────────────
// Access Requests (for Google/OAuth onboarding)
// ─────────────────────────────────────────────

model AccessRequest {
  id          String        @id @default(cuid())
  status      RequestStatus @default(PENDING)
  message     String?       // Optional message from the user
  workspaceId String?       // If they request a specific workspace
  resolvedBy  String?       // User ID of who approved/denied
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("access_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

// ─────────────────────────────────────────────
// Notification Preferences
// ─────────────────────────────────────────────

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  scanComplete     Boolean @default(true)
  weeklyDigest     Boolean @default(true)
  newViolations    Boolean @default(true)
  complianceAlerts Boolean @default(true)
  teamActivity     Boolean @default(false)
  scheduledReports Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

// ─────────────────────────────────────────────
// External Integrations
// ─────────────────────────────────────────────

model Integration {
  id            String   @id @default(cuid())
  provider      String   // "slack", "jira", "github", etc.
  name          String?  // user-given label
  enabled       Boolean  @default(true)
  accessToken   String?  // encrypted OAuth token
  refreshToken  String?  // encrypted refresh token
  webhookUrl    String?  // incoming webhook URL (Slack, Teams)
  externalId    String?  // external workspace/project ID
  config        Json?    // provider-specific config (channel, project key, etc.)
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspaceId   String
  userId        String   // who connected it

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("integrations")
}

// ─────────────────────────────────────────────
// Saved Auth Configs (encrypted credentials for authenticated scanning)
// ─────────────────────────────────────────────

model AuthConfig {
  id            String   @id @default(cuid())
  name          String   // User-facing label
  domain        String?  // Target domain (informational)
  method        String   // cookies | form | basic | headers
  encryptedData String   @db.Text // AES-256-GCM encrypted JSON (never exposed to client)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  workspaceId   String

  @@unique([workspaceId, name])
  @@index([userId])
  @@index([workspaceId])
  @@map("auth_configs")
}

// ─────────────────────────────────────────────
// White-Label Agency Platform
// ─────────────────────────────────────────────

model Agency {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  customDomain      String?     @unique
  logoUrl           String?
  primaryColor      String      @default("#6366f1")
  accentColor       String      @default("#4f46e5")
  faviconUrl        String?
  brandName         String
  supportEmail      String?
  plan              AgencyPlan  @default(STARTER)
  revenueSharePct   Int         @default(0)
  maxClients        Int         @default(10)
  isActive          Boolean     @default(true)
  ownerId           String
  owner             User        @relation(fields: [ownerId], references: [id])
  clients           AgencyClient[]
  apiKeys           AgencyApiKey[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([ownerId])
  @@map("agencies")
}

enum AgencyPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model AgencyClient {
  id            String    @id @default(cuid())
  agencyId      String
  workspaceId   String    @unique
  agency        Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  clientName    String
  contactEmail  String
  isActive      Boolean   @default(true)
  addedAt       DateTime  @default(now())

  @@index([agencyId])
  @@map("agency_clients")
}

model AgencyApiKey {
  id          String    @id @default(cuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  keyHash     String    @unique
  keyPrefix   String
  label       String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([agencyId])
  @@map("agency_api_keys")
}

// ─────────────────────────────────────────────
// Lawsuit Risk Score Engine
// ─────────────────────────────────────────────

model LitigationRiskScore {
  id                  String   @id @default(cuid())
  siteId              String
  scanId              String   @unique
  site                Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  scan                Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  baseScore           Float
  finalScore          Float
  tier                RiskTier
  industry            String
  primaryGeo          String
  industryMultiplier  Float
  geoMultiplier       Float
  estimatedExposure   Float
  violationBreakdown  Json
  topRiskFactors      Json
  narrative           String?
  calculatedAt        DateTime @default(now())

  @@index([siteId, calculatedAt])
  @@map("litigation_risk_scores")
}

enum RiskTier {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model LitigationWeight {
  id              String   @id @default(cuid())
  ruleId          String   @unique
  weight          Float
  frequency       Float
  avgSettlement   Float
  updatedAt       DateTime @updatedAt

  @@map("litigation_weights")
}

// ─────────────────────────────────────────────
// Compliance Proof Vault
// ─────────────────────────────────────────────

model ComplianceProof {
  id            String        @id @default(cuid())
  siteId        String
  scanId        String?
  workspaceId   String
  type          ProofType
  title         String
  description   String?
  score         Float?
  standard      String        // e.g. "WCAG 2.1 AA", "EN 301 549", "Section 508"
  evidence      Json          // snapshot of scan data, violation counts, etc.
  hash          String        // SHA-256 over canonical(evidence + prevHash + chainIndex + issuedAt)
  prevHash      String?       // hash of the previous proof in this workspace's chain (null = genesis)
  chainIndex    Int           @default(0) // 0-based position in the workspace's hash chain
  anchoredAt    DateTime?     // when the hash was externally anchored (e.g. OpenTimestamps)
  anchorProof   String?       // opaque external anchor receipt, if any
  issuedAt      DateTime      @default(now())
  expiresAt     DateTime?     // optional: proof validity period
  revokedAt     DateTime?     // set if score drops below threshold
  revokedReason String?

  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, chainIndex])
  @@index([workspaceId, issuedAt])
  @@index([siteId, issuedAt])
  @@index([hash])
  @@map("compliance_proofs")
}

enum ProofType {
  SCAN_CERTIFICATE
  COMPLIANCE_SNAPSHOT
  REMEDIATION_RECORD
  AUDIT_ATTESTATION
  CONTINUOUS_MONITORING
}

// ─────────────────────────────────────────────
// CI/CD Regression Guard
// ─────────────────────────────────────────────

model GuardPolicy {
  id                  String    @id @default(cuid())
  siteId              String
  workspaceId         String
  name                String
  enabled             Boolean   @default(true)

  // Absolute thresholds
  minScore            Float     @default(80)
  maxCritical         Int       @default(0)
  maxSerious          Int       @default(3)

  // Regression tolerances
  maxScoreDrop        Float     @default(5)
  maxNewViolations    Int       @default(5)

  // Baseline
  autoPromoteBaseline Boolean   @default(true)
  baselineScanId      String?
  baselineScore       Float?
  baselineLockedAt    DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  site                Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([siteId, name])
  @@index([workspaceId])
  @@map("guard_policies")
}

/// Organization-defined compliance policy evaluated over scan results.
/// THRESHOLD: { minScore }              — overall score floor
/// RULE_REQUIRED: { axeRuleId }         — a specific axe rule must have zero violations
/// IMPACT_BUDGET: { impact, maxCount }  — at most N violations of a given impact
/// CRITERION_REQUIRED: { criterion }    — a WCAG criterion (e.g. "1.4.3") must have zero violations
enum ComplianceRuleType {
  THRESHOLD
  RULE_REQUIRED
  IMPACT_BUDGET
  CRITERION_REQUIRED
}

model ComplianceRule {
  id          String             @id @default(cuid())
  workspaceId String
  name        String
  description String?
  enabled     Boolean            @default(true)
  type        ComplianceRuleType
  config      Json
  severity    Impact             @default(serious)
  createdBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("compliance_rules")
}

/// Enterprise SSO — multi-tenant. Our routing/provisioning metadata; the actual
/// IdP config lives in BoxyHQ Jackson's own tables keyed by (tenant=workspaceId, product).
/// SSO is ADDITIVE in v1 (never enforced) so a broken IdP can't lock anyone out.
enum SsoProtocol {
  SAML
  OIDC
}

enum SsoRolloutStage {
  DISABLED
  INTERNAL
  BETA
  GA
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DomainVerificationMethod {
  DNS_TXT
  EMAIL
}

enum SsoHealthStatus {
  ACTIVE
  WARNING
  EXPIRED_CERT
  INVALID_METADATA
  VALIDATION_FAILED
  DISABLED
}

enum SsoEnforcementPolicy {
  OPTIONAL
  ENFORCED
  ENFORCED_VERIFIED_DOMAINS
}

enum SsoAttributeTarget {
  firstName
  lastName
  fullName
  department
  title
  location
  employeeId
}

enum SsoConnectionChangeType {
  CREATED
  UPDATED
  DELETED
  ENABLED
  DISABLED
  DOMAIN_VERIFIED
  ROLE_MAPPING_CHANGED
}

model SSOConnection {
  id                String               @id @default(cuid())
  workspaceId       String
  product           String               @default("reglayer")
  label             String
  protocol          SsoProtocol
  defaultRole       Role                 @default(MEMBER)
  rolloutStage      SsoRolloutStage      @default(DISABLED)
  // v1 is always OPTIONAL (additive); ENFORCED ships only at GA with a break-glass path
  enforcementPolicy SsoEnforcementPolicy @default(OPTIONAL)
  // Reliability / health (#21, #22)
  healthStatus         SsoHealthStatus   @default(ACTIVE)
  certificateExpiresAt DateTime?
  warningThresholdDays Int               @default(30)
  lastValidatedAt      DateTime?
  // SCIM forward-compat (unused in v1; reserved so SCIM adds no migration pain)
  scimEnabled    Boolean                 @default(false)
  scimEndpoint   String?
  scimSecretHash String?
  lastLoginAt    DateTime?
  lastSSOLoginAt DateTime?
  createdBy      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  disabledAt     DateTime? // soft-disable
  deletedAt      DateTime? // soft-delete — releases owned domains

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domains           SsoDomain[]
  roleMappings      SsoRoleMapping[]
  attributeMappings SsoAttributeMapping[]
  auditEvents       SsoConnectionAudit[]

  @@index([workspaceId])
  @@map("sso_connections")
}

model SsoDomain {
  id                 String                    @id @default(cuid())
  connectionId       String
  workspaceId        String // denormalized for routing + uniqueness
  domain             String // always stored lowercased
  isPrimary          Boolean                   @default(false)
  verificationStatus DomainVerificationStatus  @default(PENDING)
  verificationMethod DomainVerificationMethod?
  verificationToken  String
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime                  @default(now())
  deletedAt          DateTime?

  connection         SSOConnection             @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // Global uniqueness of VERIFIED, non-deleted domains is enforced at the app layer
  // (transaction-guarded check) AND a Postgres partial unique index added via raw SQL
  // (CREATE UNIQUE INDEX ... WHERE verification_status='VERIFIED' AND deleted_at IS NULL),
  // since Prisma can't express partial-unique declaratively.
  @@index([connectionId])
  @@index([domain, verificationStatus, deletedAt])
  @@map("sso_domains")
}

/// IdP group → workspace role (#25). Schema now, wired in the provisioning phase.
model SsoRoleMapping {
  id           String        @id @default(cuid())
  connectionId String
  idpGroup     String
  role         Role
  createdAt    DateTime      @default(now())

  connection   SSOConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, idpGroup])
  @@index([connectionId])
  @@map("sso_role_mappings")
}

/// IdP attribute → user profile field (#26). Schema now, wired in the provisioning phase.
model SsoAttributeMapping {
  id           String             @id @default(cuid())
  connectionId String
  sourceAttr   String
  targetField  SsoAttributeTarget
  createdAt    DateTime           @default(now())

  connection   SSOConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, targetField])
  @@index([connectionId])
  @@map("sso_attribute_mappings")
}

/// Tamper-evident change history for SSO config (#32): who/when/before/after/why.
model SsoConnectionAudit {
  id           String                  @id @default(cuid())
  connectionId String
  actor        String?
  changeType   SsoConnectionChangeType
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime                @default(now())

  connection   SSOConnection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@map("sso_connection_audit")
}

/// Service accounts exempt from SSO enforcement (#24), so automation never gets locked out.
model ServiceAccount {
  id                       String    @id @default(cuid())
  workspaceId              String
  email                    String
  label                    String
  exemptFromSsoEnforcement Boolean   @default(true)
  createdBy                String?
  createdAt                DateTime  @default(now())

  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("service_accounts")
}

// ─────────────────────────────────────────────
// Human Testing Network
// ─────────────────────────────────────────────

model Tester {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  bio             String?
  expertise       String[]
  certifications  String[]
  assistiveTech   String[]
  disabilities    String[]
  hourlyRate      Float     @default(0)
  currency        String    @default("USD")
  availability    String    @default("available") // available | limited | unavailable
  completedAudits Int       @default(0)
  averageRating   Float     @default(0)
  region          String    @default("US")
  languages       String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  auditRequests   AuditRequest[]

  @@map("testers")
}

model AuditRequest {
  id              String    @id @default(cuid())
  workspaceId     String
  siteId          String
  testerId        String?
  type            String    // full-audit | screen-reader-test | keyboard-test | etc.
  status          String    @default("draft") // draft | submitted | matched | in-progress | review | completed | cancelled
  scope           String
  requirements    String?
  urgency         String    @default("standard") // standard | rush | critical
  budget          Float?
  currency        String    @default("USD")
  findings        Json?
  combinedScore   Float?
  automatedScore  Float?
  manualScore     Float?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tester          Tester?   @relation(fields: [testerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([testerId])
  @@map("audit_requests")
}

// ─────────────────────────────────────────────
// Blog CMS — Admin-editable articles
// ─────────────────────────────────────────────

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  category    String        // "WCAG", "EAA", "Legal", "Technical", etc.
  content     Json          // Structured sections array
  status      ArticleStatus @default(DRAFT)
  readTime    String        @default("5 min")
  authorId    String?       // User who created
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Version history — append-only, never deletes old content
  versions    ArticleVersion[]

  @@index([status, publishedAt])
  @@map("articles")
}

model ArticleVersion {
  id          String   @id @default(cuid())
  articleId   String
  content     Json     // Full snapshot of content at this point
  title       String
  excerpt     String
  editedBy    String   // User ID who made the edit
  editMethod  String   @default("manual") // "manual" | "ai"
  changeNote  String?  // What was changed
  createdAt   DateTime @default(now())

  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@map("article_versions")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─────────────────────────────────────────────
// Crawl Durability (R-5) — survives Vercel cold starts
// ─────────────────────────────────────────────

model CrawlJobRecord {
  id           String   @id
  workspaceId  String?
  userId       String?
  rootUrl      String
  status       String   @default("processing") // processing|complete|failed|cancelled
  progress     Int      @default(0)
  pagesScanned Int      @default(0)
  pagesTotal   Int      @default(0)
  result       Json?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, createdAt])
  @@map("crawl_jobs")
}

// ─────────────────────────────────────────────
// RUM Persistence (R-6) — durable real-user events
// ─────────────────────────────────────────────

model RumEventRecord {
  id          String   @id @default(cuid())
  workspaceId String?
  siteKey     String
  type        String
  selector    String
  page        String
  sessionId   String
  viewport    Json?
  details     Json?
  userAgent   String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([workspaceId, occurredAt])
  @@index([siteKey, occurredAt])
  @@map("rum_events")
}

// ── Fix Genome ──
// Crowd-verified remediation outcomes. One row per confirmed (or refuted) fix attempt,
// keyed by the violation's ruleId + a normalized structural fingerprint. Aggregating
// across tenants yields "for this barrier, fix X works Y% of the time, median Z days" —
// a network-effect dataset no single-site tool can assemble. Standalone (no enforced
// relations) so an outcome survives deletion of its source scan/violation, mirroring
// the RumEventRecord pattern.
model FixOutcomeRecord {
  id           String   @id @default(cuid())
  workspaceId  String?
  siteId       String?
  violationId  String?
  ruleId       String // axe rule id — the primary fingerprint key
  fingerprint  String // ruleId + normalized selector, for finer-grained grouping
  fixCategory  String? // optional fix taxonomy label
  impact       String? // violation impact at fix time
  verifiedVia  String // "re-scan" | "rum-drop" | "manual"
  success      Boolean // did the rule stop appearing after the fix?
  detectedAt   DateTime? // when the violation was first detected
  verifiedAt   DateTime // when this outcome was confirmed
  daysToEffect Float? // verifiedAt − detectedAt, in days, when both are known
  createdAt    DateTime @default(now())

  @@index([ruleId, success])
  @@index([workspaceId, ruleId, createdAt])
  @@index([fingerprint, success])
  @@map("fix_outcomes")
}

// ── Vendor Accessibility Liability Graph (VALG) ──
// One row per (scan, vendor) observation. Aggregating across tenants scores every
// third-party widget by the real-world accessibility liability it injects across all
// sites that embed it — "the Moody's of web components" — and tracks regression over
// time. Standalone (no enforced relations) so an observation survives deletion of its
// source scan, mirroring the RumEventRecord / FixOutcomeRecord pattern.
model VendorObservation {
  id             String   @id @default(cuid())
  workspaceId    String?
  siteId         String?
  scanId         String?
  vendor         String // vendor display name (e.g. "Intercom")
  category       String // VendorCategory (e.g. "chat-widget")
  violationCount Int // violations attributed to this vendor in the scan
  riskScore      Int // 0–100 vendor risk score from the scanner
  observedAt     DateTime
  createdAt      DateTime @default(now())

  @@index([vendor, observedAt])
  @@index([workspaceId, observedAt])
  @@map("vendor_observations")
}
