// ─────────────────────────────────────────────
// Blog CMS — Admin-editable articles
// ─────────────────────────────────────────────

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  category    String        // "WCAG", "EAA", "Legal", "Technical", etc.
  content     Json          // Structured sections array
