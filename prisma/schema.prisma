// RegLayer — Database Schema
// Multi-tenant accessibility compliance platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Identity & Multi-Tenancy
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  plan          Plan      @default(FREE)
  aiCreditsUsed Int       @default(0)
  bonusCredits  Int       @default(0)
  creditResetAt DateTime  @default(now())
  isMasterAdmin Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  memberships    WorkspaceMember[]
  scans          Scan[]
  apiKeys        ApiKey[]
  accessRequests AccessRequest[]
  creditGrants   CreditGrant[]
  agencies       Agency[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Credit Grants (admin → user, max 3x/month/user)
// ─────────────────────────────────────────────

model CreditGrant {
  id        String   @id @default(cuid())
  amount    Int
  reason    String?
  grantedBy String   // admin user ID
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_grants")
}

// ─────────────────────────────────────────────
// Password Reset OTP
// ─────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, otp])
  @@map("password_resets")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members      WorkspaceMember[]
  sites        Site[]
  scans        Scan[]
  schedules    Schedule[]
  webhooks     Webhook[]
  apiKeys      ApiKey[]
  agencyClient AgencyClient?
  featureOverrides WorkspaceFeature[]

  @@map("workspaces")
}

// ─────────────────────────────────────────────
// Feature Gating (per-workspace overrides)
// ─────────────────────────────────────────────

model WorkspaceFeature {
  id          String   @id @default(cuid())
  feature     String   // e.g. "executive", "agency", "compliance", "automation"
  enabled     Boolean  @default(true)
  grantedBy   String   // master admin user ID who enabled/disabled
  grantedAt   DateTime @default(now())
  expiresAt   DateTime? // optional: time-limited trial access
  note        String?  // admin note, e.g. "Annual deal includes Executive"

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, feature])
  @@map("workspace_features")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────────────
// Sites & Monitoring
// ─────────────────────────────────────────────

model Site {
  id          String   @id @default(cuid())
  url         String
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Relations
  scans       Scan[]
  schedules   Schedule[]
  riskScores  LitigationRiskScore[]

  @@unique([workspaceId, url])
  @@map("sites")
}

// ─────────────────────────────────────────────
// Scans & Results
// ─────────────────────────────────────────────

model Scan {
  id            String     @id @default(cuid())
  url           String
  status        ScanStatus @default(PENDING)
  score         Float?
  totalViolations Int      @default(0)
  critical      Int        @default(0)
  serious       Int        @default(0)
  moderate      Int        @default(0)
  minor         Int        @default(0)
  compliance    Float?
  pageTitle     String?
  duration      Int?       // milliseconds
  screenshot    String?    // base64 or URL
  metadata      Json?      // additional scan metadata
  errorMessage  String?

  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())

  // Relations
  workspaceId   String?
  siteId        String?
  userId        String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  site          Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  violations    Violation[]
  riskScore     LitigationRiskScore?

  @@index([workspaceId, createdAt])
  @@index([userId])
  @@index([url])
  @@index([status])
  @@map("scans")
}

model Violation {
  id              String   @id @default(cuid())
  ruleId          String   // axe rule ID (e.g., "color-contrast")
  impact          Impact
  description     String
  help            String
  helpUrl         String?
  tags            String[] // WCAG tags
  wcagCriteria    String?  // e.g., "1.4.3"
  wcagLevel       String?  // A, AA, AAA
  affectedElements Json    // array of { html, target, failureSummary }
  aiExplanation   String?  // cached AI explanation

  // ── Status Tracking (Fix Flow integration) ──
  status          ViolationStatus @default(OPEN)
  statusNote      String?         // required reason for WONT_FIX or ACCEPTABLE_RISK
  statusUpdatedAt DateTime?       // last status change timestamp
  statusUpdatedBy String?         // userId who changed status
  verifiedAt      DateTime?       // set when re-scan confirms fix is applied

  scanId          String
  scan            Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([ruleId])
  @@index([status])
  @@map("violations")
}

enum ViolationStatus {
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED        // confirmed fixed by re-scan
  WONT_FIX        // intentional decision — requires statusNote
  ACCEPTABLE_RISK // documented exception — requires statusNote
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum Impact {
  critical
  serious
  moderate
  minor
}

// ─────────────────────────────────────────────
// Scheduling & Automation
// ─────────────────────────────────────────────

model Schedule {
  id          String   @id @default(cuid())
  name        String
  cron        String   // cron expression
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  siteId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([siteId])
  @@index([enabled, nextRunAt])
  @@map("schedules")
}

// ─────────────────────────────────────────────
// Integrations
// ─────────────────────────────────────────────

model Webhook {
  id          String      @id @default(cuid())
  url         String
  events      String[]    // ["scan.completed", "score.dropped"]
  secret      String?     // HMAC signing secret
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())

  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique // hashed API key
  prefix      String   // first 8 chars for identification
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────
// Audit Trail
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // "scan.created", "member.invited", etc.
  actor       String?  // user ID
  target      String?  // resource ID
  metadata    Json?
  createdAt   DateTime @default(now())

  workspaceId String?

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Product Analytics / Conversion Tracking
// ─────────────────────────────────────────────

model ConversionEvent {
  id         String   @id @default(cuid())
  event      String   // "demo_scan", "signup_started", "signup_completed", "first_scan", "plan_upgraded"
  sessionId  String   // anonymous session ID (cookie-based)
  userId     String?  // set after signup
  email      String?  // set after signup
  ip         String?
  referrer   String?
  userAgent  String?
  metadata   Json?    // { url, score, source, etc. }
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([event, createdAt])
  @@index([userId])
  @@map("conversion_events")
}

// ─────────────────────────────────────────────
// Access Requests (for Google/OAuth onboarding)
// ─────────────────────────────────────────────

model AccessRequest {
  id          String        @id @default(cuid())
  status      RequestStatus @default(PENDING)
  message     String?       // Optional message from the user
  workspaceId String?       // If they request a specific workspace
  resolvedBy  String?       // User ID of who approved/denied
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("access_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

// ─────────────────────────────────────────────
// Notification Preferences
// ─────────────────────────────────────────────

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  scanComplete     Boolean @default(true)
  weeklyDigest     Boolean @default(true)
  newViolations    Boolean @default(true)
  complianceAlerts Boolean @default(true)
  teamActivity     Boolean @default(false)
  scheduledReports Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

// ─────────────────────────────────────────────
// External Integrations
// ─────────────────────────────────────────────

model Integration {
  id            String   @id @default(cuid())
  provider      String   // "slack", "jira", "github", etc.
  name          String?  // user-given label
  enabled       Boolean  @default(true)
  accessToken   String?  // encrypted OAuth token
  refreshToken  String?  // encrypted refresh token
  webhookUrl    String?  // incoming webhook URL (Slack, Teams)
  externalId    String?  // external workspace/project ID
  config        Json?    // provider-specific config (channel, project key, etc.)
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspaceId   String
  userId        String   // who connected it

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("integrations")
}

// ─────────────────────────────────────────────
// Saved Auth Configs (encrypted credentials for authenticated scanning)
// ─────────────────────────────────────────────

model AuthConfig {
  id            String   @id @default(cuid())
  name          String   // User-facing label
  domain        String?  // Target domain (informational)
  method        String   // cookies | form | basic | headers
  encryptedData String   @db.Text // AES-256-GCM encrypted JSON (never exposed to client)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  workspaceId   String

  @@unique([workspaceId, name])
  @@index([userId])
  @@index([workspaceId])
  @@map("auth_configs")
}

// ─────────────────────────────────────────────
// White-Label Agency Platform
// ─────────────────────────────────────────────

model Agency {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  customDomain      String?     @unique
  logoUrl           String?
  primaryColor      String      @default("#6366f1")
  accentColor       String      @default("#4f46e5")
  faviconUrl        String?
  brandName         String
  supportEmail      String?
  plan              AgencyPlan  @default(STARTER)
  revenueSharePct   Int         @default(0)
  maxClients        Int         @default(10)
  isActive          Boolean     @default(true)
  ownerId           String
  owner             User        @relation(fields: [ownerId], references: [id])
  clients           AgencyClient[]
  apiKeys           AgencyApiKey[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([ownerId])
  @@map("agencies")
}

enum AgencyPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model AgencyClient {
  id            String    @id @default(cuid())
  agencyId      String
  workspaceId   String    @unique
  agency        Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  clientName    String
  contactEmail  String
  isActive      Boolean   @default(true)
  addedAt       DateTime  @default(now())

  @@index([agencyId])
  @@map("agency_clients")
}

model AgencyApiKey {
  id          String    @id @default(cuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  keyHash     String    @unique
  keyPrefix   String
  label       String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([agencyId])
  @@map("agency_api_keys")
}

// ─────────────────────────────────────────────
// Lawsuit Risk Score Engine
// ─────────────────────────────────────────────

model LitigationRiskScore {
  id                  String   @id @default(cuid())
  siteId              String
  scanId              String   @unique
  site                Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  scan                Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  baseScore           Float
  finalScore          Float
  tier                RiskTier
  industry            String
  primaryGeo          String
  industryMultiplier  Float
  geoMultiplier       Float
  estimatedExposure   Float
  violationBreakdown  Json
  topRiskFactors      Json
  narrative           String?
  calculatedAt        DateTime @default(now())

  @@index([siteId, calculatedAt])
  @@map("litigation_risk_scores")
}

enum RiskTier {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model LitigationWeight {
  id              String   @id @default(cuid())
  ruleId          String   @unique
  weight          Float
  frequency       Float
  avgSettlement   Float
  updatedAt       DateTime @updatedAt

  @@map("litigation_weights")
}
