// ─────────────────────────────────────────────
// AI Chat Conversations (persisted user chat history)
// ─────────────────────────────────────────────

model ChatConversation {
  id          String   @id @default(cuid())
  title       String?  // Auto-generated from first message, user-editable
  userId      String
  workspaceId String?
  messages    ChatMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime? // Soft delete

  // Optimistic concurrency. Saving is a delete-all-and-recreate keyed on id, so two
  // tabs saving the same conversation silently clobbered each other — last writer won
  // and the loser's messages were gone with no error anywhere. A save must now carry
  // the version it read; a mismatch is rejected rather than applied.
  version     Int      @default(0)

  // Cross-tab generation lease. The client-side lease prevents concurrent runs within
  // ONE tab; it cannot span tabs, because each holds its own in-memory state. Ownership
  // enforced here is the only kind that holds across tabs, devices, and restarts.
  runOwner    String?   // opaque token identifying the owning tab/session
  runExpires  DateTime? // heartbeat deadline — a dead owner's lease expires rather than deadlocking

  @@index([userId, updatedAt])
  @@index([workspaceId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  role           String   // "user" | "assistant"
  content        String   @db.Text
  feedback       Int      @default(0) // -1, 0, 1
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ─────────────────────────────────────────────
// AI Memory (Long-term user/workspace preferences)
// ─────────────────────────────────────────────

model AiMemory {
  id          String   @id @default(cuid())
  scope       AiMemoryScope @default(USER)
  key         String   // e.g. "preferred_wcag_level", "industry", "tech_stack"
  value       String   // the remembered fact/preference
  confidence  Float    @default(1.0) // how confident we are (decays over time)
  source      String?  // what caused this memory ("user_stated", "inferred", "admin_set")
  expiresAt   DateTime? // optional TTL for time-sensitive memories

  userId      String?
  workspaceId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, workspaceId, key])
  @@index([userId, scope])
  @@index([workspaceId, scope])
  @@map("ai_memories")
}

enum AiMemoryScope {
  USER       // personal preferences (e.g. "prefers code examples")
  WORKSPACE  // shared team knowledge (e.g. "our tech stack is React + Next.js")
  SYSTEM     // global facts set by admins (e.g. "compliance deadline is June 2025")
}

// ─────────────────────────────────────────────
// Human Approval Workflows
// ─────────────────────────────────────────────

model ApprovalRequest {
  id            String         @id @default(cuid())
  type          ApprovalType   // what kind of content needs approval
  status        ApprovalStatus @default(PENDING)
  title         String         // human-readable title for the review queue
  content       Json           // the AI-generated draft content (type-specific)
  metadata      Json?          // additional context (source scanId, model used, etc.)

  // Who submitted and who reviewed
  requestedBy   String         // userId who triggered the AI generation
  reviewedBy    String?        // userId who approved/rejected
  reviewNote    String?        // reviewer's comment
  reviewedAt    DateTime?

  // Workspace scoping
  workspaceId   String

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  expiresAt     DateTime?      // optional: auto-expire stale drafts

  @@index([workspaceId, status])
  @@index([requestedBy])
  @@index([status, createdAt])
  @@map("approval_requests")
}

enum ApprovalType {
  COMPLIANCE_REPORT   // monthly/quarterly PDF report
  ACCESSIBILITY_STATEMENT // public a11y statement
  REMEDIATION_PLAN    // prioritized fix plan
  CERTIFICATE         // compliance certificate
  POLICY_UPDATE       // guard policy or rule change
}

enum ApprovalStatus {
  PENDING     // awaiting human review
  APPROVED    // human approved → ready to publish
  REJECTED    // human rejected with feedback
  EXPIRED     // auto-expired (stale draft)
  PUBLISHED   // approved AND published/sent
}

// ─────────────────────────────────────────────
// Knowledge Base (RAG over custom documents)
// ─────────────────────────────────────────────

model KnowledgeDocument {
  id          String   @id @default(cuid())
  title       String
  source      String   // original filename or URL
  mimeType    String   // "application/pdf", "text/markdown", etc.
  sizeBytes   Int      @default(0)
  status      KnowledgeStatus @default(PROCESSING)
  chunkCount  Int      @default(0)
  errorMessage String?

  workspaceId String
  uploadedBy  String   // userId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks      KnowledgeChunk[]

  @@index([workspaceId, status])
  @@index([uploadedBy])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  content     String   // the text content of this chunk
  chunkIndex  Int      // position in the document (0-based)
  tokenCount  Int      @default(0)
  metadata    Json?    // page number, section heading, etc.

  // pgvector embedding for semantic search
  embedding   Unsupported("vector(1536)")?

  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([documentId, chunkIndex])
  @@map("knowledge_chunks")
}

enum KnowledgeStatus {
  PROCESSING  // being chunked + embedded
  READY       // available for RAG queries
  FAILED      // processing error
}

// ─────────────────────────────────────────────
// AI Experiments (A/B prompt testing)
// ─────────────────────────────────────────────

model AiExperiment {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      ExperimentStatus @default(DRAFT)
  feature     String   // which AI feature this tests (e.g. "chat", "violation-explainer")

  // Variant A (control)
  promptA     String   @db.Text
  modelA      String   // e.g. "gpt-4o-mini"
  temperatureA Float   @default(0.4)

  // Variant B (challenger)
  promptB     String   @db.Text
  modelB      String
  temperatureB Float   @default(0.4)

  // Traffic split (0.0–1.0 = % sent to variant B)
  trafficSplit Float   @default(0.5)

  // Results (aggregated)
  totalTrials  Int     @default(0)
  trialsA      Int     @default(0)
  trialsB      Int     @default(0)
  avgLatencyA  Float   @default(0)
  avgLatencyB  Float   @default(0)
  avgCostA     Float   @default(0)
  avgCostB     Float   @default(0)
  avgRatingA   Float?  // user thumbs up/down aggregated
  avgRatingB   Float?

  workspaceId String
  createdBy   String   // userId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startedAt   DateTime?
  endedAt     DateTime?

  @@index([workspaceId, status])
  @@index([feature])
  @@map("ai_experiments")
}

enum ExperimentStatus {
  DRAFT       // configured but not running
  RUNNING     // actively splitting traffic
  PAUSED      // temporarily stopped
  COMPLETED   // finished, results final
}

// ─────────────────────────────────────────────
// Knowledge Graph (Graph RAG)
// ─────────────────────────────────────────────

model KnowledgeEntity {
  id          String   @id @default(cuid())
  type        String   // "site", "violation", "wcag_criterion", "regulation", "team_member", "policy", "document"
  name        String   // human-readable label
  properties  Json?    // arbitrary structured metadata
  embedding   Unsupported("vector(1536)")?  // entity embedding for graph + vector fusion

  workspaceId String?  // null for global entities (WCAG criteria, regulations)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outgoing    KnowledgeEdge[] @relation("EdgeFrom")
  incoming    KnowledgeEdge[] @relation("EdgeTo")

  @@unique([workspaceId, type, name])
  @@index([workspaceId, type])
  @@index([type])
  @@map("knowledge_entities")
}

model KnowledgeEdge {
  id          String   @id @default(cuid())
  relation    String   // "violates", "owns", "scanned_by", "fixed_by", "part_of", "member_of", "governs"
  weight      Float    @default(1.0) // edge strength (recency, frequency, confidence)
  properties  Json?    // edge metadata (e.g. "scan_date", "fix_version")

  fromId      String
  toId        String
  from        KnowledgeEntity @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          KnowledgeEntity @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([fromId, toId, relation])
  @@index([fromId, relation])
  @@index([toId, relation])
  @@index([relation])
  @@map("knowledge_edges")
}

// ─────────────────────────────────────────────
// Agent Marketplace + A2A Protocol
// ─────────────────────────────────────────────

model AgentBlueprint {
  id            String   @id @default(cuid())
  slug          String   @unique  // "compliance-auditor", "legal-analyst"
  name          String
  description   String
  category      String   // "compliance", "legal", "development", "research", "custom"
  version       Int      @default(1)
  systemPrompt  String   @db.Text
  model         String   @default("gpt-4o-mini")
  temperature   Float    @default(0.4)
  maxTokens     Int      @default(2000)
  tools         String[] // tool IDs this agent can use
  permissions   String[] // resource scopes: "scans.read", "violations.write", etc.
  costLimitUsd  Float?   // max $ per invocation
  isPublic      Boolean  @default(false) // visible in marketplace
  isSystem      Boolean  @default(false) // built-in (cannot delete)

  createdBy     String?  // userId (null for system agents)
  workspaceId   String?  // null for global/system agents

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations AgentConversation[]

  @@index([workspaceId, category])
  @@index([isPublic, category])
  @@map("agent_blueprints")
}

model AgentConversation {
  id          String   @id @default(cuid())
  status      AgentConversationStatus @default(RUNNING)
  initiator   String   // userId or agentBlueprintId that started this
  metadata    Json?    // task description, parameters

  blueprintId String
  blueprint   AgentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  workspaceId String

  messages    AgentMessage[]

  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([workspaceId, status])
  @@index([blueprintId])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(cuid())
  role           AgentMessageRole
  content        String   @db.Text
  fromAgentSlug  String?  // which agent sent this (null for user/system)
  toAgentSlug    String?  // which agent this is addressed to (null for broadcast)
  toolCalls      Json?    // tool call requests/results
  tokenCount     Int      @default(0)
  costUsd        Float    @default(0)
  latencyMs      Int      @default(0)

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([fromAgentSlug])
  @@map("agent_messages")
}

enum AgentConversationStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentMessageRole {
  USER       // human user
  AGENT      // agent response
  SYSTEM     // system instruction
  HANDOFF    // agent-to-agent delegation
  TOOL       // tool call result
}

// ─────────────────────────────────────────────
// Agent Scheduler + Autonomous Agents
// ─────────────────────────────────────────────

model AgentSchedule {
  id            String   @id @default(cuid())
  name          String
  agentSlug     String   // which agent blueprint to run
  trigger       AgentTrigger @default(CRON)
  cron          String?  // cron expression (for CRON trigger)
  eventType     String?  // event name (for EVENT trigger): "scan.completed", "score.dropped"
  taskTemplate  String   @db.Text // prompt template with {{variables}}
  enabled       Boolean  @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  runCount      Int      @default(0)
  lastError     String?

  // What to do with the agent's output
  outputAction  AgentOutputAction @default(LOG)
  notifyEmail   String?  // email recipient for NOTIFY action
  webhookUrl    String?  // URL for WEBHOOK action

  workspaceId   String
  createdBy     String   // userId

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs          AgentScheduleRun[]

  @@index([workspaceId, enabled])
  @@index([trigger, nextRunAt])
  @@index([eventType])
  @@map("agent_schedules")
}

model AgentScheduleRun {
  id          String   @id @default(cuid())
  status      ScheduleRunStatus @default(RUNNING)
  trigger     String   // "cron", "event:scan.completed", "manual"
  input       Json?    // resolved task + event data
  output      String?  @db.Text // agent's response
  error       String?
  costUsd     Float    @default(0)
  durationMs  Int      @default(0)

  scheduleId  String
  schedule    AgentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([scheduleId, createdAt])
  @@index([status])
  @@map("agent_schedule_runs")
}

enum AgentTrigger {
  CRON      // time-based: hourly, daily, weekly, custom cron
  EVENT     // event-driven: scan.completed, score.dropped, violation.new
  MANUAL    // on-demand (API or UI button)
}

enum AgentOutputAction {
  LOG       // just persist the output (audit trail)
  NOTIFY    // email the result to notifyEmail
  WEBHOOK   // POST the result to webhookUrl
  APPROVE   // create an ApprovalRequest for human review
}

enum ScheduleRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────
// Semantic User Profile + Long-Term Learning
// ─────────────────────────────────────────────

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique

  writingStyle   String?  // "concise" | "detailed" | "technical" | "non-technical"
  preferredTone  String?  // "formal" | "casual" | "instructional"
  preferredModel String?  // user's favorite model
  language       String?  // "en" | "es" | "de"

  domainExpertise  String[] // ["frontend", "legal", "design", "qa"]
  industries       String[] // ["ecommerce", "healthcare", "fintech"]
  techStack        String[] // ["react", "nextjs", "tailwind"]
  wcagLevel        String?  // "A" | "AA" | "AAA"
  regulations      String[] // ["ADA", "EAA", "Section508"]

  frequentTools    String[] // tool IDs used most often
  topFeatures      String[] // features used most: "chat", "scan", "report"
  totalQueries     Int      @default(0)
  totalFeedback    Int      @default(0)
  avgRating        Float?

  prefersCodeExamples  Boolean @default(false)
  prefersCitations     Boolean @default(true)
  prefersShortAnswers  Boolean @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("user_profiles")
}

model FeedbackEntry {
  id          String   @id @default(cuid())
  rating      Int      // 1-5 or -1/+1 thumbs
  comment     String?
  category    String?  // "accuracy" | "relevance" | "helpfulness" | "tone"

  feature     String   // "chat" | "violation-explainer" | "agent"
  messageId   String?
  promptId    String?
  model       String?

  query       String?  @db.Text
  response    String?  @db.Text
  context     Json?

  userId      String
  workspaceId String?

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, rating])
  @@index([promptId, rating])
  @@index([model, rating])
  @@map("feedback_entries")
}

model PromptImprovement {
  id              String   @id @default(cuid())
  promptId        String
  version         Int
  improvementType String   // "rewrite" | "example_added" | "constraint_added" | "tone_shift"
  description     String

  originalSegment String?  @db.Text
  improvedSegment String?  @db.Text

  source          String   // "feedback_analysis" | "experiment_winner" | "manual" | "auto_learning"
  feedbackCount   Int      @default(0)
  avgRatingBefore Float?
  avgRatingAfter  Float?

  status          ImprovementStatus @default(PROPOSED)
  appliedAt       DateTime?
  appliedBy       String?

  createdAt       DateTime @default(now())

  @@index([promptId, status])
  @@index([source])
  @@map("prompt_improvements")
}

enum ImprovementStatus {
  PROPOSED
  APPROVED
  APPLIED
  REJECTED
}

// ─────────────────────────────────────────────
// AI Audit Trail + Compliance
// ─────────────────────────────────────────────

model AiAuditEntry {
  id            String   @id @default(cuid())

  // WHO
  userId        String?
  email         String?
  apiKeyId      String?
  workspaceId   String?

  // WHAT
  action        String   // "chat" | "rag" | "embed" | "agent" | "workflow" | "tool"
  feature       String?  // specific feature name

  // PROMPT
  promptId      String?
  promptVersion Int?
  promptHash    String?  // SHA-256 of system prompt (audit without storing PII)

  // MODEL
  model         String?
  provider      String?
  temperature   Float?

  // INPUT/OUTPUT (hashed for PII protection)
  inputHash     String?  // SHA-256 of user query
  inputTokens   Int      @default(0)
  outputHash    String?  // SHA-256 of AI response
  outputTokens  Int      @default(0)

  // COST
  costUsd       Float    @default(0)
  durationMs    Int      @default(0)

  // LINEAGE
  traceId       String?  // links to LineageTrace

  // APPROVAL
  approvalId    String?  // links to ApprovalRequest if human review required
  approved      Boolean?

  // COMPLIANCE
  consentBasis  String?  // GDPR: "legitimate_interest" | "consent" | "contract"
  retainUntil   DateTime? // auto-delete date per retention policy
  dataClassification String? // "public" | "internal" | "confidential" | "restricted"
  piiDetected   Boolean  @default(false)
  piiRedacted   Boolean  @default(false)

  // METADATA
  ipAddress     String?
  userAgent     String?
  metadata      Json?

  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([traceId])
  @@index([retainUntil])
  @@map("ai_audit_entries")
}

model CompliancePolicy {
  id              String   @id @default(cuid())
  framework       String   // "GDPR" | "SOC2" | "ISO27001" | "HIPAA" | "AI_ACT"
  controlId       String   // e.g. "GDPR-17" (right to erasure), "SOC2-CC6.1"
  controlName     String
  description     String
  status          ComplianceControlStatus @default(NOT_ASSESSED)
  evidence        String?  @db.Text  // how this control is satisfied
  automatedCheck  Boolean  @default(false) // can be verified programmatically
  lastAssessedAt  DateTime?
  lastAssessedBy  String?

  workspaceId     String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workspaceId, framework, controlId])
  @@index([workspaceId, framework])
  @@index([status])
  @@map("compliance_policies")
}

enum ComplianceControlStatus {
  NOT_ASSESSED
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

// ── Team Collaboration ────────────────────────────────────────────────────────

