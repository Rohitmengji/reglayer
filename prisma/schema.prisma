// ─────────────────────────────────────────────
// RUM Persistence (R-6) — durable real-user events
// ─────────────────────────────────────────────

model RumEventRecord {
  id          String   @id @default(cuid())
  workspaceId String?
  siteKey     String
  type        String
  selector    String
  page        String
  sessionId   String
  viewport    Json?
  details     Json?
  userAgent   String?
