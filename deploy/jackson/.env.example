# ── Jackson service (deploy/jackson/docker-compose.yml) ───────────────────────
# Jackson's own datastore. Can be a dedicated DB or your existing Postgres
# (Jackson namespaces its own jackson_* tables).
JACKSON_DB_URL=<your-postgres-connection-string>   # e.g. a Neon/RDS Postgres URL, sslmode=require

# Public HTTPS URL where THIS Jackson is reachable.
JACKSON_EXTERNAL_URL=https://sso.yourdomain.com

# Must EXACTLY match the SP Entity ID RegLayer advertises (see docs/sso/README.md).
SAML_AUDIENCE=https://saml.reglayer.dev

# Strong secret. RegLayer authenticates to the management API with `Api-Key <this>`.
JACKSON_API_KEY=replace-with-a-long-random-secret

# Jackson's own admin UI (optional). Lock down or omit in production.
JACKSON_NEXTAUTH_SECRET=replace-with-a-random-secret
JACKSON_ADMIN_CREDENTIALS=admin@yourdomain.com:replace-with-a-password

# ── RegLayer app — set these in Vercel (NOT in this file) ─────────────────────
# SSO_ENABLED=true
# SSO_BACKEND=service
# SSO_JACKSON_URL=https://sso.yourdomain.com      # = JACKSON_EXTERNAL_URL
# SSO_JACKSON_API_KEY=...                          # = JACKSON_API_KEY
