# ---------------------------------------------------------
# RegLayer — Environment Configuration
# ---------------------------------------------------------
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
# Required vars are validated at startup by src/lib/env.ts —
# the app fails fast with a clear error if they're missing.
# ---------------------------------------------------------

# ── Required ────────────────────────────────────────────────
# PostgreSQL connection string (Neon serverless in production)
DATABASE_URL=postgresql://user:password@localhost:5432/reglayer
# NextAuth session signing secret (min 16 chars; `openssl rand -base64 32`)
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=RegLayer
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth providers (optional) ───────────────────────────────
# Enables "Continue with Google" on login when both are set
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# Dev seed accounts (local only — never set in production)
# SEED_MASTER_EMAIL=master@example.com
# SEED_MASTER_PASSWORD=change-me
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me

# ── AI features (optional — graceful degradation when unset) ─
# OPENAI_API_KEY=sk-...

# ── Rate limiting (optional — falls back to in-memory) ──────
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ── Billing (optional — Stripe) ─────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# ── Email (SMTP — required for team invitations and notifications) ───────────
# Without these, an invited member cannot be sent their temporary password.
# The app is provider-agnostic: set the four SMTP_* values for ANY provider.
#
# Option A — Gmail (personal/testing, ~500/day). Needs a 16-char App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=RegLayer <you@gmail.com>
#
# Option B — Mailtrap Email Testing (free sandbox; captures mail, no real delivery).
#   Inbox → SMTP Settings shows the username/password tokens for that inbox.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-inbox-username
# SMTP_PASS=your-mailtrap-inbox-password
# EMAIL_FROM=RegLayer <noreply@reglayer.app>
#
# Option C — Mailtrap Email Sending (real delivery; needs a verified domain).
#   Username is literally "api"; password is your Sending API/SMTP token.
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=api
# SMTP_PASS=your-mailtrap-sending-token
# EMAIL_FROM=RegLayer <noreply@your-verified-domain.com>
#
# In development, if none of these are set the app auto-uses a free Ethereal
# test inbox and logs a preview link per message (no signup, no delivery).

# ── Observability (optional — Sentry) ───────────────────────
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org
# SENTRY_PROJECT=reglayer
# SENTRY_AUTH_TOKEN=sntrys_...   # source-map uploads in CI only

# ── Scheduled scans / scanner ───────────────────────────────
# Shared secret for /api/cron/* endpoints
# CRON_SECRET=replace-with-a-long-random-string
# AES key for encrypting stored site credentials (32 bytes, base64)
# ENCRYPTION_KEY=replace-with-32-byte-base64-key
SCAN_TIMEOUT=30000
MAX_CONCURRENT_SCANS=5
CRAWL_PAGE_CHECKPOINTS_ENABLED=false

# ── SEO (optional) ──────────────────────────────────────────
# Canonical public origin, independent of NEXTAUTH_URL. No path or trailing slash.
SITE_URL=https://reglayer.vercel.app
# Vercel production indexes by default; preview/development never do.
# Self-hosted production must explicitly opt in. Set false to block any deployment.
# SEO_INDEXING_ENABLED=true
# GOOGLE_SITE_VERIFICATION=your-verification-token
